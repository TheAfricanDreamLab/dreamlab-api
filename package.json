{
  "name": "dreamlab-api",
  "version": "0.1.0",
  "private": true,
  "description": "Dream Lab OS backend: NestJS microservices (gateway, iam, catalog, learning, notify, admissions) with a transactional outbox over RabbitMQ",
  "license": "Apache-2.0",
  "author": "African Dream Network",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "nest build gateway && nest build iam && nest build catalog && nest build learning && nest build notify && nest build admissions",
    "build:gateway": "nest build gateway",
    "build:iam": "nest build iam",
    "build:catalog": "nest build catalog",
    "build:learning": "nest build learning",
    "build:notify": "nest build notify",
    "build:admissions": "nest build admissions",
    "dev": "node scripts/dev.mjs",
    "dev:gateway": "nest start gateway --watch",
    "dev:iam": "nest start iam --watch",
    "dev:catalog": "nest start catalog --watch",
    "dev:learning": "nest start learning --watch",
    "dev:notify": "nest start notify --watch",
    "dev:admissions": "nest start admissions --watch",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "iam:migrate": "ts-node -r tsconfig-paths/register apps/iam/src/cli.ts migrate",
    "iam:seed": "ts-node -r tsconfig-paths/register apps/iam/src/cli.ts seed",
    "iam:rotate-keys": "ts-node -r tsconfig-paths/register apps/iam/src/cli.ts rotate-keys",
    "iam:generate": "drizzle-kit generate --config apps/iam/drizzle.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "license-check": "license-checker-rseidelsohn --production --onlyAllow \"Apache-2.0;MIT;BSD-2-Clause;BSD-3-Clause;ISC;Unicode-3.0;Zlib;0BSD;BlueOak-1.0.0;Python-2.0;CC0-1.0\" --excludePrivatePackages",
    "catalog:migrate": "ts-node -r tsconfig-paths/register apps/catalog/src/cli.ts migrate",
    "catalog:seed": "ts-node -r tsconfig-paths/register apps/catalog/src/cli.ts seed",
    "catalog:generate": "drizzle-kit generate --config apps/catalog/drizzle.config.ts",
    "learning:migrate": "ts-node -r tsconfig-paths/register apps/learning/src/cli.ts migrate",
    "learning:generate": "drizzle-kit generate --config apps/learning/drizzle.config.ts",
    "notify:migrate": "ts-node -r tsconfig-paths/register apps/notify/src/cli.ts migrate",
    "admissions:migrate": "ts-node -r tsconfig-paths/register apps/admissions/src/cli.ts migrate",
    "notify:generate": "drizzle-kit generate --config apps/notify/drizzle.config.ts",
    "admissions:generate": "drizzle-kit generate --config apps/admissions/drizzle.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@azure/storage-blob": "12.34.0",
    "@dreamlab/contracts": "github:TheAfricanDreamLab/dreamlab-contracts#v0.13.0",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@ts-rest/core": "3.52.1",
    "amqp-connection-manager": "4.1.15",
    "amqplib": "0.10.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "livekit-server-sdk": "2.19.1",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/rabbitmq": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/amqplib": "0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "license-checker-rseidelsohn": "4.4.2",
    "pino-pretty": "13.2.0",
    "testcontainers": "11.14.0",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "xml-crypto": "6.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@dreamlab/contracts",
      "@nestjs/core",
      "esbuild",
      "cpu-features",
      "ssh2"
    ],
    "overrides": {
      "fastify": "5.12.7",
      "js-yaml@>=5.0.0 <5.4.1": "5.5.0"
    }
  }
}
