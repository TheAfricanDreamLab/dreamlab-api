# Copy to .env for local development. Matches docker-compose.yml.

# --- shared ---
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://dreamlab:dreamlab@localhost:5672
# Production: https://api.theafricandreamlab.com
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=dreamlab-api
SWAGGER_ENABLED=true
# Proxies allowed to set X-Forwarded-For: loopback in development; the gateway network / edge proxy in production.
TRUST_PROXY=loopback
# Shared secret the gateway sends to services so they can trust tenant headers. 32+ random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_GATEWAY_TOKEN=REPLACE_WITH_32+_RANDOM_CHARS

# --- gateway ---
GATEWAY_PORT=3000
IAM_URL=http://localhost:3001
IAM_JWKS_URL=http://localhost:3001/.well-known/jwks.json
CATALOG_URL=http://localhost:3002
LEARNING_URL=http://localhost:3003
# Base domains. <slug>.<base> is that organisation's site; the base itself and api.<base> mean no tenant (B2C).
# Production: theafricandreamlab.com (tenants at <slug>.theafricandreamlab.com, API at api.theafricandreamlab.com).
GATEWAY_BASE_DOMAINS=localhost,theafricandreamlab.com
# Browser origins allowed by CORS; * matches one subdomain label.
CORS_ORIGINS=http://localhost:3100,http://*.localhost:3100,https://theafricandreamlab.com,https://*.theafricandreamlab.com
# Allow the X-Tenant header to pick a tenant (for curl and Swagger). Never enable in production.
GATEWAY_ALLOW_TENANT_HEADER=true
GATEWAY_RATE_LIMIT_PER_MINUTE=300

# --- iam ---
IAM_PORT=3001
IAM_DATABASE_URL=postgres://iam_app:iam_app@localhost:5433/dreamlab_iam
IAM_SYSTEM_DATABASE_URL=postgres://iam_system:iam_system@localhost:5433/dreamlab_iam
IAM_MIGRATION_DATABASE_URL=postgres://iam_owner:iam_owner@localhost:5433/dreamlab_iam
IAM_MIGRATE_ON_BOOT=true
IAM_SEED_ON_BOOT=true
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IAM_KEY_ENCRYPTION_SECRET=REPLACE_WITH_32_BYTES_BASE64
BOOTSTRAP_ADMIN_EMAIL=admin@theafricandreamlab.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-please
SEED_DEMO_ORGS=true
PUBLIC_APP_URL=http://localhost:3100

# The gateway's public address (SCIM base URL, SAML metadata links).
PUBLIC_API_URL=http://localhost:3000

# --- enterprise identity (iam): domains, SSO, SCIM, MFA ---
# dns: domains verify through a DNS TXT record. trust: every domain verifies (development only).
DOMAIN_VERIFY_MODE=dns
# Allow identity-provider URLs on private networks / plain http (development only).
SSO_ALLOW_PRIVATE_URLS=false
# Platform admins need an authenticator app for platform-wide actions.
PLATFORM_ADMIN_MFA_REQUIRED=false

# --- SMS and WhatsApp codes (iam) ---
# Termii is used when TERMII_API_KEY is set; otherwise codes are only logged (development)
# and production refuses phone codes. SMS_PROVIDER=termii|console overrides.
TERMII_API_KEY=
TERMII_SENDER_ID=DreamLab
# dnd reaches numbers on the do-not-disturb list (needs a DND-approved sender id); generic does not.
TERMII_SMS_CHANNEL=dnd

# --- email (iam) ---
# Resend is used when RESEND_API_KEY is set, otherwise ZeptoMail when ZEPTOMAIL_TOKEN is set,
# otherwise messages are only logged (development). EMAIL_PROVIDER=resend|zeptomail|console forces one.
EMAIL_FROM=The African Dream Lab <no-reply@theafricandreamlab.com>
RESEND_API_KEY=
ZEPTOMAIL_TOKEN=
# ZeptoMail region endpoint: .com (US), .eu, .in, .com.au, ... matching your Zoho account
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# --- Google sign-in (iam) ---
# Comma-separated OAuth client ids whose ID tokens are accepted (web, Android, iOS).
# Create them in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_IDS=

# --- catalog ---
CATALOG_PORT=3002
CATALOG_DATABASE_URL=postgres://catalog_app:catalog_app@localhost:5433/dreamlab_catalog
CATALOG_SYSTEM_DATABASE_URL=postgres://catalog_system:catalog_system@localhost:5433/dreamlab_catalog
CATALOG_MIGRATION_DATABASE_URL=postgres://catalog_owner:catalog_owner@localhost:5433/dreamlab_catalog
CATALOG_MIGRATE_ON_BOOT=true
# Test content: The African Dream Lab programme with the full Problem Solving course. Staging and
# development only; leave empty in production, where courses are imported by a platform admin.
CATALOG_SEED=dream-lab-test

# --- learning ---
LEARNING_PORT=3003
LEARNING_DATABASE_URL=postgres://learning_app:learning_app@localhost:5433/dreamlab_learning
LEARNING_SYSTEM_DATABASE_URL=postgres://learning_system:learning_system@localhost:5433/dreamlab_learning
LEARNING_MIGRATION_DATABASE_URL=postgres://learning_owner:learning_owner@localhost:5433/dreamlab_learning
LEARNING_MIGRATE_ON_BOOT=true
