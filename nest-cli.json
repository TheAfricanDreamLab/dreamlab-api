{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "iam": {
      "type": "application",
      "root": "apps/iam",
      "entryFile": "main",
      "sourceRoot": "apps/iam/src",
      "compilerOptions": {
        "tsConfigPath": "apps/iam/tsconfig.app.json",
        "assets": [
          {
            "include": "database/migrations/**/*",
            "outDir": "dist/apps/iam",
            "watchAssets": true
          }
        ]
      }
    },
    "catalog": {
      "type": "application",
      "root": "apps/catalog",
      "entryFile": "main",
      "sourceRoot": "apps/catalog/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog/tsconfig.app.json",
        "assets": [
          {
            "include": "database/migrations/**/*",
            "outDir": "dist/apps/catalog",
            "watchAssets": true
          }
        ]
      }
    },
    "learning": {
      "type": "application",
      "root": "apps/learning",
      "entryFile": "main",
      "sourceRoot": "apps/learning/src",
      "compilerOptions": {
        "tsConfigPath": "apps/learning/tsconfig.app.json",
        "assets": [
          {
            "include": "database/migrations/**/*",
            "outDir": "dist/apps/learning",
            "watchAssets": true
          }
        ]
      }
    },
    "notify": {
      "type": "application",
      "root": "apps/notify",
      "entryFile": "main",
      "sourceRoot": "apps/notify/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notify/tsconfig.app.json",
        "assets": [
          {
            "include": "database/migrations/**/*",
            "outDir": "dist/apps/notify",
            "watchAssets": true
          }
        ]
      }
    },
    "admissions": {
      "type": "application",
      "root": "apps/admissions",
      "entryFile": "main",
      "sourceRoot": "apps/admissions/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admissions/tsconfig.app.json",
        "assets": [
          {
            "include": "database/migrations/**/*",
            "outDir": "dist/apps/admissions",
            "watchAssets": true
          }
        ]
      }
    }
  }
}
